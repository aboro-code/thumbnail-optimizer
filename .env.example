# Used by docker-compose.yml. Copy to .env and fill in.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=60m
# Optional: Google sign-in (same OAuth client id for backend and frontend)
GOOGLE_CLIENT_ID=
# heuristic (default) or trained
SCORING_STRATEGY=heuristic
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Host port for the app
APP_PORT=8080
# HTTPS mode only (docker-compose.https.yml): your domain, or <ip-with-dashes>.sslip.io
DOMAIN=
